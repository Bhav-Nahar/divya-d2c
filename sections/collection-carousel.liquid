{%- liquid
  assign s = section.settings
-%}

<div
  class="
    collection-carousel-section section section--{{ s.section_width }} spacing-style
    {% if s.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.background_color != blank -%}
    {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
  {%- endif -%}

  {%- if s.heading != blank -%}
    <div
      class="collection-carousel__header collection-carousel__header--{{ s.heading_alignment }}"
      style="--cc-heading-gap: {{ s.heading_gap }}px;"
    >
      <h2 class="collection-carousel__heading {{ s.heading_level }}">{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}
        <p class="collection-carousel__subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <collection-carousel
    class="collection-carousel"
    style="
      --cc-slide-w: {{ s.slide_width }};
      --cc-slide-w-mobile: {{ s.slide_width_mobile }};
      --cc-gap: {{ s.gap }}px;
      --cc-ratio: {{ s.ratio }};
      --cc-radius: {{ s.corner_radius }}px;
    "
  >
    {%- if s.show_arrows and section.blocks.size > 1 -%}
      <button
        class="collection-carousel__arrow collection-carousel__arrow--prev"
        type="button"
        data-cc-step="-1"
        aria-label="{{ 'content.pagination.previous' | t }}"
      >
        <svg class="collection-carousel__chevron" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="20" height="20">{%- render 'icon', icon: 'arrow' -%}</svg>
      </button>
    {%- endif -%}

    <ul class="collection-carousel__track" data-cc-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign label = block.settings.label | default: coll.title
          assign url = block.settings.link | default: coll.url
          assign image = block.settings.image | default: coll.featured_image
          assign video = block.settings.video
        -%}
        <li class="collection-carousel__slide" {{ block.shopify_attributes }}>
          <a class="collection-carousel__link" href="{{ url | default: '#' }}">
            <span class="collection-carousel__media">
              {%- if video != blank -%}
                {{
                  video
                  | video_tag:
                    image_size: '1200x',
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    class: 'collection-carousel__video'
                }}
              {%- elsif image != blank -%}
                {{
                  image
                  | image_url: width: 1600
                  | image_tag: widths: '400,600,800,1200,1600', sizes: '(max-width: 749px) 85vw, 60vw', loading: 'lazy', alt: label
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if s.overlay_opacity > 0 -%}
                <span
                  class="collection-carousel__scrim"
                  style="--cc-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};"
                ></span>
              {%- endif -%}
            </span>

            {%- if label != blank or block.settings.cta != blank -%}
              <span
                class="collection-carousel__caption collection-carousel__caption--{{ s.caption_position }}"
                style="--cc-caption-color: {{ s.caption_color }};"
              >
                {%- if label != blank -%}
                  <span class="collection-carousel__label">{{ label }}</span>
                {%- endif -%}
                {%- if block.settings.cta != blank -%}
                  <span class="collection-carousel__cta">{{ block.settings.cta }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- comment -%} ponytail: placeholders so the section is visible before slides are added {%- endcomment -%}
        {%- for i in (1..3) -%}
          <li class="collection-carousel__slide">
            <span class="collection-carousel__link">
              <span class="collection-carousel__media">{{ 'collection-1' | placeholder_svg_tag }}</span>
              <span class="collection-carousel__caption collection-carousel__caption--{{ s.caption_position }}">
                <span class="collection-carousel__label">Collection</span>
              </span>
            </span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if s.show_arrows and section.blocks.size > 1 -%}
      <button
        class="collection-carousel__arrow collection-carousel__arrow--next"
        type="button"
        data-cc-step="1"
        aria-label="{{ 'content.pagination.next' | t }}"
      >
        <svg class="collection-carousel__chevron" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="20" height="20">{%- render 'icon', icon: 'arrow' -%}</svg>
      </button>
    {%- endif -%}
  </collection-carousel>
</div>

{% javascript %}
  // ponytail: native scroll does the work — this only wires the arrows to it.
  class CollectionCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-cc-track]');
      if (!this.track) return;

      // ponytail: open on the middle slide so both peeks show art. Measured off
      // rects rather than offsetLeft, which depends on the offsetParent.
      requestAnimationFrame(() => {
        const slides = this.track.querySelectorAll('.collection-carousel__slide');
        if (slides.length < 3) return;
        const target = slides[Math.floor(slides.length / 2)];
        const trackRect = this.track.getBoundingClientRect();
        const slideRect = target.getBoundingClientRect();
        this.track.scrollLeft +=
          slideRect.left - trackRect.left - (trackRect.width - slideRect.width) / 2;
      });

      this.addEventListener('click', (event) => {
        const arrow = event.target.closest('[data-cc-step]');
        if (!arrow) return;
        const slide = this.track.querySelector('.collection-carousel__slide');
        if (!slide) return;
        const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
        this.track.scrollBy({
          left: (slide.offsetWidth + gap) * Number(arrow.dataset.ccStep),
          behavior: 'smooth',
        });
      });
    }
  }

  if (!customElements.get('collection-carousel')) {
    customElements.define('collection-carousel', CollectionCarousel);
  }
{% endjavascript %}

{% stylesheet %}
  .collection-carousel__header {
    margin-block-end: var(--cc-heading-gap, 32px);
  }

  .collection-carousel__header--center {
    text-align: center;
  }

  .collection-carousel__header--left {
    text-align: left;
  }

  .collection-carousel__heading {
    margin: 0;
    line-height: 1.15;
    text-wrap: balance;
  }

  .collection-carousel__subheading {
    margin: 0.5rem 0 0 0;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .collection-carousel {
    position: relative;
    display: block;
    /* Slide width and track padding must resolve against the same box, so both
       are measured in cqw off this element rather than the padded track. */
    container-type: inline-size;
  }

  .collection-carousel__track {
    display: flex;
    gap: var(--cc-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* Inline padding lets the first and last slides settle in the centre, which
       is what produces the peek on both sides. */
    scroll-padding-inline: calc((100cqw - var(--cc-slide-w-mobile) * 1cqw) / 2);
    padding-inline: calc((100cqw - var(--cc-slide-w-mobile) * 1cqw) / 2);
  }

  .collection-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .collection-carousel__slide {
    flex: 0 0 calc(var(--cc-slide-w-mobile) * 1cqw);
    scroll-snap-align: center;
  }

  .collection-carousel__link {
    display: block;
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .collection-carousel__media {
    display: block;
    position: relative;
    aspect-ratio: var(--cc-ratio);
    overflow: hidden;
    border-radius: var(--cc-radius);
    background: var(--color-background-secondary, #f3f3f3);
  }

  .collection-carousel__media :is(img, svg, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-carousel__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / var(--cc-overlay)) 0%, transparent 60%);
    pointer-events: none;
  }

  .collection-carousel__caption {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--cc-caption-color);
  }

  .collection-carousel__caption--over {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.25rem;
    text-align: center;
  }

  .collection-carousel__caption--below {
    margin-block-start: 1rem;
    text-align: center;
  }

  .collection-carousel__label {
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .collection-carousel__cta {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    opacity: 0.85;
  }

  .collection-carousel__arrow {
    position: absolute;
    top: calc(50% - 1.375rem);
    z-index: 2;
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.12);
    color: #000;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .collection-carousel__arrow:hover {
    background: #fff;
  }

  .collection-carousel__arrow--prev {
    inset-inline-start: 0.5rem;
    rotate: 180deg;
  }

  .collection-carousel__arrow--next {
    inset-inline-end: 0.5rem;
  }

  .collection-carousel__arrow svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentcolor;
  }

  @media screen and (min-width: 750px) {
    .collection-carousel__track {
      scroll-padding-inline: calc((100cqw - var(--cc-slide-w) * 1cqw) / 2);
      padding-inline: calc((100cqw - var(--cc-slide-w) * 1cqw) / 2);
    }

    .collection-carousel__slide {
      flex-basis: calc(var(--cc-slide-w) * 1cqw);
    }

    .collection-carousel__arrow {
      display: flex;
    }

    /* Hover emphasis only — the label never hides, so touch loses nothing. */
    .collection-carousel__link:hover .collection-carousel__media :is(img, video) {
      transform: scale(1.04);
    }

    .collection-carousel__link:hover .collection-carousel__cta {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-carousel__media :is(img, svg, video) {
      transition: none;
    }

    .collection-carousel__link:hover .collection-carousel__media :is(img, video) {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Icons of Summer"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading size",
      "info": "Uses the theme's heading scale, set in Theme settings > Typography.",
      "options": [
        { "value": "h1", "label": "Extra large" },
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" },
        { "value": "h4", "label": "Small" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Slides"
    },
    {
      "type": "range",
      "id": "slide_width",
      "label": "Desktop slide width",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 60,
      "info": "Under 100% leaves the neighbouring slides peeking."
    },
    {
      "type": "range",
      "id": "slide_width_mobile",
      "label": "Mobile slide width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between slides",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Slide ratio",
      "options": [
        { "value": "3 / 4", "label": "3:4 portrait" },
        { "value": "4 / 5", "label": "4:5 portrait" },
        { "value": "1 / 1", "label": "1:1 square" },
        { "value": "4 / 3", "label": "4:3 landscape" },
        { "value": "16 / 9", "label": "16:9 wide" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Caption"
    },
    {
      "type": "select",
      "id": "caption_position",
      "label": "Caption position",
      "options": [
        { "value": "over", "label": "Over the image" },
        { "value": "below", "label": "Below the image" }
      ],
      "default": "over"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35,
      "info": "Gradient at the bottom, so captions over the image stay readable."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Supplies the image, label, and link unless overridden below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Plays muted and looping, and takes priority over the image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Link text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection carousel",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
