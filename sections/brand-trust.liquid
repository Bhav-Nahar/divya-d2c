{%- liquid
  assign s = section.settings
-%}

<div
  class="
    brand-trust-section section section--{{ s.section_width }} spacing-style
    {% if s.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.background_color != blank -%}
    {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
  {%- endif -%}

  {%- if s.heading != blank -%}
    <h2 class="brand-trust__heading">{{ s.heading }}</h2>
  {%- endif -%}

  <ul
    class="brand-trust brand-trust--{{ s.layout }} brand-trust--icon-{{ s.icon_position }}"
    style="--trust-columns: {{ section.blocks.size | at_least: 1 }}; --trust-divider: {{ s.divider_width }}px;"
  >
    {%- for block in section.blocks -%}
      <li class="brand-trust__item" {{ block.shopify_attributes }}>
        {%- capture item -%}
          {%- if block.settings.icon != 'none' or block.settings.image_upload != blank -%}
            <span class="brand-trust__icon" style="--trust-icon-color: {{ block.settings.icon_color }};">
              {%- render 'icon-or-image',
                icon: block.settings.icon,
                image_upload: block.settings.image_upload,
                width: block.settings.icon_size,
                class_name: 'brand-trust__glyph'
              -%}
            </span>
          {%- endif -%}
          <span class="brand-trust__copy">
            <span class="brand-trust__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}
              <span class="brand-trust__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
        {%- endcapture -%}

        {%- if block.settings.link != blank -%}
          <a class="brand-trust__inner" href="{{ block.settings.link }}">{{ item }}</a>
        {%- else -%}
          <span class="brand-trust__inner">{{ item }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .brand-trust__heading {
    margin: 0 0 1.5rem 0;
    text-align: center;
  }

  .brand-trust {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-trust__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    height: 100%;
    padding: 0.5rem 1rem;
    color: inherit;
    text-decoration: none;
    text-align: center;
  }

  .brand-trust--icon-above .brand-trust__inner {
    flex-direction: column;
    gap: 0.5rem;
  }

  .brand-trust__icon {
    display: flex;
    flex-shrink: 0;
    color: var(--trust-icon-color);
  }

  .brand-trust__copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .brand-trust__title {
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .brand-trust__text {
    font-size: 0.75rem;
    opacity: 0.7;
    line-height: 1.3;
  }

  .brand-trust__item + .brand-trust__item {
    border-inline-start: var(--trust-divider) solid rgb(from currentcolor r g b / 0.15);
  }

  /* Mobile: scrolling strip keeps four items on one line without shrinking the
     text; grid stacks them into rows instead. */
  .brand-trust--strip {
    grid-auto-flow: column;
    grid-auto-columns: minmax(9rem, 1fr);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .brand-trust--strip::-webkit-scrollbar {
    display: none;
  }

  .brand-trust--grid {
    grid-template-columns: repeat(2, 1fr);
    row-gap: 1.5rem;
  }

  .brand-trust--grid .brand-trust__item:nth-child(odd) {
    border-inline-start: 0;
  }

  @media screen and (min-width: 750px) {
    .brand-trust {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--trust-columns), 1fr);
      overflow-x: visible;
      row-gap: 0;
    }

    .brand-trust__item:nth-child(odd) {
      border-inline-start: var(--trust-divider) solid rgb(from currentcolor r g b / 0.15);
    }

    .brand-trust__item:first-child {
      border-inline-start: 0;
    }

    .brand-trust__title {
      font-size: 0.875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand trust",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty for a bare strip."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Mobile layout",
      "options": [
        { "value": "strip", "label": "One scrolling row" },
        { "value": "grid", "label": "Two per row" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "beside", "label": "Beside text" },
        { "value": "above", "label": "Above text" }
      ],
      "default": "beside"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider between items",
      "min": 0,
      "max": 2,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Text",
          "default": "Free & Insured Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "plane", "label": "Plane" },
            { "value": "box", "label": "Box" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "check_box", "label": "Check" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "clipboard", "label": "Certificate" },
            { "value": "chat_bubble", "label": "Chat" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "recycle", "label": "Recycle" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "image_upload",
          "label": "Custom icon",
          "info": "Replaces the icon above."
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon size",
          "min": 16,
          "max": 64,
          "step": 2,
          "unit": "px",
          "default": 24
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#000000"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand trust",
      "blocks": [
        {
          "type": "promise",
          "settings": { "title": "Free & Insured Shipping", "icon": "truck" }
        },
        {
          "type": "promise",
          "settings": { "title": "Certified Diamond & Gold Jewelry", "icon": "clipboard" }
        },
        {
          "type": "promise",
          "settings": { "title": "Lifetime Buyback or Exchange", "icon": "return" }
        },
        {
          "type": "promise",
          "settings": { "title": "15-day Money Back Guarantee", "icon": "price_tag" }
        }
      ]
    }
  ]
}
{% endschema %}
