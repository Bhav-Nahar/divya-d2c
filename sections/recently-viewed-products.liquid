{%- doc -%}
  Shows the products the visitor has looked at recently.

  The ids live in localStorage, so the list cannot be rendered on the first pass.
  The section ships empty and `recently-viewed-section.js` re-requests it through the
  Section Rendering API with a `q=id:… OR id:…` search, which fills `search.results`.
{%- enddoc -%}

<script
  src="{{ 'recently-viewed-section.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  capture styles
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--resource-list-row-gap-desktop: ' | append: section.settings.rows_gap | append: 'px;'
    echo '--resource-list-columns: repeat(' | append: section.settings.columns | append: ', 1fr);'
    echo '--resource-list-columns-mobile: repeat(' | append: section.settings.mobile_columns | append: ', 1fr);'
    echo '--column-count: ' | append: section.settings.columns | append: ';'
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
  endcapture

  assign products = search.results

  comment
    Searching by id does not preserve the order the ids were given in, so reorder
    the results to match how recently each product was viewed.
  endcomment
  if search.terms contains 'id:'
    assign ordered_ids = search.terms | replace: 'id:', '' | split: ' OR '
    assign ordered_products = '' | split: ','
    for _id in ordered_ids
      # `product.id` is a number, so the id from the search terms has to be cast to match
      assign int_id = _id | times: 1
      assign match = products | where: 'id', int_id
      assign ordered_products = ordered_products | concat: match
    endfor
    assign products = ordered_products
  endif
%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}

<recently-viewed-products
  id="recently-viewed-products-{{ section.id }}"
  class="recently-viewed-products"
  data-section-id="{{ section.id }}"
  data-exclude-product-id="{{ product.id }}"
  data-max-products="{{ section.settings.max_products }}"
  {% if products == blank or products.size == 0 %}
    hidden
  {% endif %}
  {{ section.shopify_attributes }}
>
  {% liquid
    if section.settings.background_color != blank
      render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
    endif
  %}

  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      section-resource-list
      spacing-style
      gap-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      {% render 'gap-style', value: section.settings.gap %}
      {{ styles }}
    "
  >
    <div class="section-resource-list__content">
      {% content_for 'blocks' %}
    </div>

    <div
      class="resource-list resource-list--grid"
      data-testid="resource-list-grid"
    >
      {% for product in products limit: section.settings.max_products %}
        <div class="resource-list__item">
          {% content_for 'block',
            type: '_product-card',
            id: 'static-product-card',
            closest.product: product,
            product_view_context: 'recommendation'
          %}
        </div>
      {% endfor %}
    </div>
  </div>
</recently-viewed-products>

{% schema %}
{
  "name": "Recently viewed",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
