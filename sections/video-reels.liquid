{%- comment -%}
  Video reels — a horizontal rail of vertical videos that opens into a full-screen,
  swipeable reel viewer with the products tagged in each clip.

  Deliberately library-free: the rail and the viewer are both native CSS scroll-snap,
  so there is no carousel JS to download. Videos carry no src until they scroll into
  view, load a small 720p source in the rail and a larger one in the viewer, and only
  the clip on screen ever plays.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<video-reels
  class="
    reels-section section section--{{ s.section_width }} spacing-style
    {% if s.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.background_color != blank -%}
    {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
  {%- endif -%}

  {%- if s.heading != blank or s.subheading != blank -%}
    <div class="reels__header reels__header--{{ s.heading_alignment }}">
      {%- if s.heading != blank -%}
        <h2 class="reels__heading {{ s.heading_level }}">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="reels__subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <scroll-row
    {%- if s.scroll_behavior == 'auto' %} autoplay="{{ s.autoplay_speed }}"
    {%- elsif s.scroll_behavior == 'loop' %} loop{% endif %}
  >
    <ul
      class="reels"
      data-scroll-track
      style="--reels-columns: {{ s.columns }}; --reels-gap: {{ s.gap }}px; --reels-radius: {{ s.corner_radius }}px; --reels-ratio: {{ s.ratio }};"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign video = block.settings.video
          assign poster = block.settings.poster | default: video.preview_image

          # Two source sizes: a light one for the rail, a sharper one for full screen.
          assign rail_src = ''
          assign full_src = ''
          for source in video.sources
            if source.format == 'mp4'
              if source.height <= 720
                assign rail_src = source.url
              endif
              if source.height <= 1080
                assign full_src = source.url
              endif
            endif
          endfor
          if rail_src == blank
            assign rail_src = full_src
          endif
          if block.settings.video_url != blank
            assign rail_src = block.settings.video_url
            assign full_src = block.settings.video_url
          endif

        -%}

        {%- if rail_src == blank -%}
          {%- comment -%} No video yet: show the slot so the section is visible while setting up. {%- endcomment -%}
          <li class="reels__item" {{ block.shopify_attributes }}>
            <span class="reel-card reel-card--empty">
              {%- if poster != blank -%}
                {{ poster | image_url: width: 720 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 62vw, 20vw', widths: '300,480,720', alt: '' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'reel-card__placeholder' }}
              {%- endif -%}
              <span class="reel-card__caption">Add a video to this block</span>
            </span>
          </li>
        {%- else -%}
          <li class="reels__item" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="reel-card"
              data-reel-open="{{ forloop.index0 }}"
              aria-label="Play video {{ forloop.index }}{% if block.settings.caption != blank %}: {{ block.settings.caption | escape }}{% endif %}"
            >
              {%- comment -%}
                The cover is a lazy <img>, not the video's poster attribute: a poster is
                fetched as soon as the element renders, an img with loading="lazy" is not.
              {%- endcomment -%}
              {%- if poster != blank -%}
                <span class="reel-card__cover">
                  {{
                    poster
                    | image_url: width: 720
                    | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 62vw, 20vw', widths: '240,360,480,720', alt: ''
                  }}
                </span>
              {%- endif -%}

              <video
                class="reel-card__video"
                data-reel-src="{{ rail_src }}"
                muted
                loop
                playsinline
                preload="none"
                tabindex="-1"
                aria-hidden="true"
              ></video>

              <span class="reel-card__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.3-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z"/></svg>
              </span>

              {%- if block.settings.product_1 != blank -%}
                <span class="reel-card__tag" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false"><path d="M6 7V6a6 6 0 0 1 12 0v1h2.1a1 1 0 0 1 1 1.1l-1.2 12a2 2 0 0 1-2 1.8H6.1a2 2 0 0 1-2-1.8l-1.2-12A1 1 0 0 1 3.9 7H6Zm2 0h8V6a4 4 0 0 0-8 0v1Z"/></svg>
                  Shop
                </span>
              {%- endif -%}

              {%- if block.settings.caption != blank -%}
                <span class="reel-card__caption">{{ block.settings.caption }}</span>
              {%- endif -%}
            </button>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {% render 'scroll-row-arrows', label: 'videos' %}
  </scroll-row>

  {%- comment -%}
    The viewer. One dialog for the whole section; slides snap vertically like a reel
    feed, and each video only gets a src once its slide is reached.
  {%- endcomment -%}
  <dialog class="reels-viewer" data-reels-dialog aria-label="{{ s.heading | default: 'Videos' | escape }}">
    <div class="reels-viewer__track" data-reels-track tabindex="-1">
      {%- for block in section.blocks -%}
        {%- liquid
          assign video = block.settings.video
          assign poster = block.settings.poster | default: video.preview_image
          assign full_src = ''
          for source in video.sources
            if source.format == 'mp4' and source.height <= 1080
              assign full_src = source.url
            endif
          endfor
          if block.settings.video_url != blank
            assign full_src = block.settings.video_url
          endif
        -%}

        {%- if full_src != blank -%}
          <section class="reel-slide" data-reel-slide data-reel-index="{{ forloop.index0 }}">
            <div class="reel-slide__stage">
              <video
                class="reel-slide__video"
                data-reel-src="{{ full_src }}"
                {% if poster != blank %}poster="{{ poster | image_url: width: 1080 }}"{% endif %}
                muted
                loop
                playsinline
                preload="none"
              ></video>
              <button type="button" class="reel-slide__toggle" data-reel-playpause aria-label="Pause or play video"></button>
              <span class="reel-slide__paused" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.3-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z"/></svg>
              </span>
            </div>

            {%- if block.settings.product_1 != blank or block.settings.product_2 != blank or block.settings.product_3 != blank -%}
              <div class="reel-slide__products">
                {%- if block.settings.caption != blank -%}
                  <p class="reel-slide__caption">{{ block.settings.caption }}</p>
                {%- endif -%}
                <ul class="reel-products">
                  {%- for i in (1..3) -%}
                    {%- liquid
                      case i
                        when 1
                          assign product = block.settings.product_1
                        when 2
                          assign product = block.settings.product_2
                        when 3
                          assign product = block.settings.product_3
                      endcase
                    -%}
                    {%- if product != blank -%}
                      {%- liquid
                        assign variant = product.selected_or_first_available_variant
                        assign on_sale = false
                        if variant.compare_at_price > variant.price
                          assign on_sale = true
                        endif
                      -%}
                      <li class="reel-products__item">
                        <a class="reel-product" href="{{ product.url }}">
                          <span class="reel-product__media">
                            {%- if product.featured_media != blank -%}
                              {{
                                product.featured_media
                                | image_url: width: 200
                                | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '72px', alt: product.title
                              }}
                            {%- endif -%}
                          </span>
                          <span class="reel-product__info">
                            <span class="reel-product__title">{{ product.title }}</span>
                            <span class="reel-product__prices">
                              <span class="reel-product__price{% if on_sale %} reel-product__price--sale{% endif %}">
                                {%- render 'format-price', price: variant.price -%}
                              </span>
                              {%- if on_sale -%}
                                <s class="reel-product__compare">
                                  {%- render 'format-price', price: variant.compare_at_price -%}
                                </s>
                              {%- endif -%}
                            </span>
                          </span>
                          <span class="reel-product__cta" aria-hidden="true">
                            <svg viewBox="0 0 20 20" focusable="false"><path d="M7.3 4.3a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.4-1.4L11.6 10 7.3 5.7a1 1 0 0 1 0-1.4Z"/></svg>
                          </span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </section>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="reels-viewer__ui">
      <button type="button" class="reels-viewer__btn reels-viewer__close" data-reels-close aria-label="Close videos">
        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M6.4 5a1 1 0 0 0-1.4 1.4L10.6 12 5 17.6A1 1 0 0 0 6.4 19L12 13.4 17.6 19a1 1 0 0 0 1.4-1.4L13.4 12 19 6.4A1 1 0 0 0 17.6 5L12 10.6 6.4 5Z"/></svg>
      </button>
      <button type="button" class="reels-viewer__btn reels-viewer__sound" data-reels-sound aria-pressed="true" aria-label="Unmute video">
        <svg class="reels-viewer__icon-muted" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11 4.6a1 1 0 0 0-1.7-.7L6 7H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h2l3.3 3.1a1 1 0 0 0 1.7-.7V4.6Zm3.3 4.7a1 1 0 0 1 1.4 0L17 10.6l1.3-1.3a1 1 0 0 1 1.4 1.4L18.4 12l1.3 1.3a1 1 0 0 1-1.4 1.4L17 13.4l-1.3 1.3a1 1 0 0 1-1.4-1.4L15.6 12l-1.3-1.3a1 1 0 0 1 0-1.4Z"/></svg>
        <svg class="reels-viewer__icon-sound" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M11 4.6a1 1 0 0 0-1.7-.7L6 7H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h2l3.3 3.1a1 1 0 0 0 1.7-.7V4.6ZM15.5 8.2a1 1 0 0 1 1.4.2 6 6 0 0 1 0 7.2 1 1 0 0 1-1.6-1.2 4 4 0 0 0 0-4.8 1 1 0 0 1 .2-1.4Z"/></svg>
      </button>
      <div class="reels-viewer__nav">
        <button type="button" class="reels-viewer__btn" data-reels-step="-1" aria-label="Previous video">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M5.3 15.7a1 1 0 0 0 1.4 0L12 10.4l5.3 5.3a1 1 0 0 0 1.4-1.4l-6-6a1 1 0 0 0-1.4 0l-6 6a1 1 0 0 0 0 1.4Z"/></svg>
        </button>
        <button type="button" class="reels-viewer__btn" data-reels-step="1" aria-label="Next video">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M18.7 8.3a1 1 0 0 0-1.4 0L12 13.6 6.7 8.3a1 1 0 0 0-1.4 1.4l6 6a1 1 0 0 0 1.4 0l6-6a1 1 0 0 0 0-1.4Z"/></svg>
        </button>
      </div>
      <p class="reels-viewer__count" data-reels-count aria-live="polite"></p>
    </div>
  </dialog>
</video-reels>

{% javascript %}
  /*
   * Reels: no carousel library. The rail and viewer are native scroll-snap, and this
   * only handles what CSS cannot — attaching sources late and keeping exactly one
   * video playing at a time.
   */
  class VideoReels extends HTMLElement {
    connectedCallback() {
      this.dialog = this.querySelector('[data-reels-dialog]');
      this.track = this.querySelector('[data-reels-track]');
      this.slides = [...this.querySelectorAll('[data-reel-slide]')];
      this.count = this.querySelector('[data-reels-count]');
      this.railVideos = [...this.querySelectorAll('.reel-card__video')];
      this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.active = 0;

      this.watchRail();
      this.addEventListener('click', this.onClick.bind(this));
      // Looping clones the rail after we have already observed it, so pick up the copies.
      this.addEventListener('scroll-row:clone', () => this.watchRail());

      if (!this.dialog) return;
      this.dialog.addEventListener('close', this.onClose.bind(this));
      this.dialog.addEventListener('keydown', this.onKeydown.bind(this));
      this.watchSlides();
    }

    /* Attach the source the first time a video is needed, then leave it: re-setting
       src would restart the download. */
    load(video) {
      if (!video || video.src) return;
      video.src = video.dataset.reelSrc;
    }

    play(video) {
      if (!video) return;
      this.load(video);
      const attempt = video.play();
      if (attempt) attempt.catch(() => {}); // autoplay can be blocked; the poster stays up
    }

    /*
     * Rail: a card downloads and plays only while it is on screen — nothing about this
     * section touches the network when the page first loads.
     */
    watchRail() {
      this.railVideos = [...this.querySelectorAll('.reel-card__video')];
      if (!this.railVideos.length) return;

      this.railObserver ||= new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target;
            if (entry.isIntersecting) {
              if (this.reduced) this.load(video);
              else if (!this.dialog?.open) this.play(video);
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.4 }
      );

      for (const video of this.railVideos) {
        if (video.dataset.reelWatched) continue;
        video.dataset.reelWatched = 'true';
        // Hold the cover until there are real frames to show, so there is no black flash.
        video.addEventListener('playing', () => video.closest('.reel-card')?.classList.add('reel-card--playing'), {
          once: true,
        });
        this.railObserver.observe(video);
      }
    }

    /* Viewer: the snapped-in slide plays, its neighbour preloads, the rest stop. */
    watchSlides() {
      if (!this.slides.length) return;
      this.slideObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target.querySelector('video');
            if (entry.isIntersecting) {
              this.active = this.slides.indexOf(entry.target);
              this.setCount();
              if (video) {
                video.muted = this.muted !== false;
                this.reduced ? this.load(video) : this.play(video);
              }
              this.load(this.slides[this.active + 1]?.querySelector('video'));
            } else if (video) {
              video.pause();
            }
          }
        },
        { root: this.track, threshold: 0.6 }
      );
      for (const slide of this.slides) this.slideObserver.observe(slide);
    }

    onClick(event) {
      const opener = event.target.closest('[data-reel-open]');
      if (opener) return this.open(Number(opener.dataset.reelOpen));
      if (event.target.closest('[data-reels-close]')) return this.dialog.close();
      if (event.target.closest('[data-reels-sound]')) return this.toggleSound();
      if (event.target.closest('[data-reel-playpause]')) return this.togglePlay();

      const step = event.target.closest('[data-reels-step]');
      if (step) this.step(Number(step.dataset.reelsStep));
    }

    open(index) {
      if (!this.dialog) return;
      for (const video of this.railVideos) video.pause();

      const slide = this.slides.find((item) => Number(item.dataset.reelIndex) === index) || this.slides[0];
      this.dialog.showModal();
      document.documentElement.classList.add('reels-viewer-open');
      // Jump without animation so the tapped clip is the one that opens.
      this.track.scrollTop = slide.offsetTop - this.track.offsetTop;
      this.active = this.slides.indexOf(slide);
      this.setCount();
      this.play(slide.querySelector('video'));
      this.track.focus({ preventScroll: true });
    }

    onClose() {
      document.documentElement.classList.remove('reels-viewer-open');
      for (const slide of this.slides) slide.querySelector('video')?.pause();
      // Hand playback back to whichever rail card is on screen.
      for (const video of this.railVideos) {
        if (!this.reduced && this.inView(video)) this.play(video);
      }
    }

    inView(element) {
      const rect = element.getBoundingClientRect();
      return rect.bottom > 0 && rect.top < window.innerHeight;
    }

    /* Wraps at both ends, so the viewer is endless like the rail. */
    step(direction) {
      const total = this.slides.length;
      if (!total) return;
      const index = (this.active + direction + total) % total;
      const wrapped = Math.abs(this.active + direction - index) > 1;
      this.track.scrollTo({
        top: this.slides[index].offsetTop - this.track.offsetTop,
        behavior: wrapped ? 'auto' : 'smooth',
      });
    }

    togglePlay() {
      const video = this.slides[this.active]?.querySelector('video');
      if (!video) return;
      const slide = this.slides[this.active];
      if (video.paused) {
        this.play(video);
        slide.classList.remove('reel-slide--paused');
      } else {
        video.pause();
        slide.classList.add('reel-slide--paused');
      }
    }

    toggleSound() {
      const button = this.querySelector('[data-reels-sound]');
      this.muted = this.muted === false;
      for (const slide of this.slides) {
        const video = slide.querySelector('video');
        if (video) video.muted = this.muted;
      }
      button.setAttribute('aria-pressed', String(this.muted));
      button.setAttribute('aria-label', this.muted ? 'Unmute video' : 'Mute video');
      this.classList.toggle('reels--sound-on', !this.muted);
      // Unmuting can void an autoplay grant, so nudge the current clip back into play.
      if (!this.muted) this.play(this.slides[this.active]?.querySelector('video'));
    }

    onKeydown(event) {
      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
        event.preventDefault();
        this.step(1);
      } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
        event.preventDefault();
        this.step(-1);
      }
    }

    setCount() {
      if (this.count) this.count.textContent = `${this.active + 1} / ${this.slides.length}`;
    }
  }

  if (!customElements.get('video-reels')) customElements.define('video-reels', VideoReels);
{% endjavascript %}

{% stylesheet %}
  .reels-section {
    --reels-edge: rgb(from currentcolor r g b / 0.1);
    --reels-muted: rgb(from currentcolor r g b / 0.58);
  }

  .reels__header {
    margin-block-end: 1.75rem;
  }

  .reels__header--center {
    text-align: center;
  }

  .reels__heading {
    margin: 0;
    line-height: 1.15;
    text-wrap: balance;
  }

  .reels__subheading {
    margin: 0.75rem auto 0;
    max-width: 46ch;
    color: var(--reels-muted);
  }

  /* Rail: one row, snapping, with the next clip peeking in. */
  .reels {
    display: flex;
    gap: var(--reels-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .reels::-webkit-scrollbar {
    display: none;
  }

  .reels__item {
    flex: 0 0 min(62%, 15rem);
    scroll-snap-align: start;
    display: flex;
  }

  .reel-card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: max(var(--reels-radius), 10px);
    overflow: hidden;
    background: light-dark(#f1f1f1, #1a1a1a);
    cursor: pointer;
    aspect-ratio: var(--reels-ratio);
    /* Paint the card as one layer: cheaper than compositing video + overlays per frame. */
    isolation: isolate;
  }

  .reel-card__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: inherit;
  }

  /* The cover sits on top and fades once the video has real frames to show. */
  .reel-card__cover {
    position: absolute;
    inset: 0;
    z-index: 1;
    transition: opacity 0.4s ease;
  }

  .reel-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reel-card--playing .reel-card__cover {
    opacity: 0;
  }

  .reel-card--empty {
    display: grid;
    place-items: center;
    cursor: default;
  }

  .reel-card--empty img,
  .reel-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reel-card__placeholder {
    fill: rgb(from currentcolor r g b / 0.2);
    background: light-dark(#ececec, #222);
  }

  .reel-card__play,
  .reel-card__tag {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .reel-card__play {
    inset: 0;
    margin: auto;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.28);
    backdrop-filter: blur(6px);
    border: 1px solid rgb(255 255 255 / 0.35);
    opacity: 0;
    transition: opacity 0.25s ease, scale 0.25s ease;
    scale: 0.85;
  }

  .reel-card__play svg {
    width: 1.125rem;
    height: 1.125rem;
    margin-inline-start: 2px;
    fill: #fff;
  }

  @media (hover: hover) {
    .reel-card:hover .reel-card__play,
    .reel-card:focus-visible .reel-card__play {
      opacity: 1;
      scale: 1;
    }
  }

  .reel-card__tag {
    inset-block-start: 0.625rem;
    inset-inline-end: 0.625rem;
    gap: 0.25rem;
    padding: 0.3125rem 0.625rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: #1a1a1a;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .reel-card__tag svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: currentcolor;
  }

  .reel-card__caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 2;
    padding: 2.5rem 0.875rem 0.75rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent);
    color: #fff;
    font-size: 0.8125rem;
    line-height: 1.35;
    text-align: start;
    text-wrap: pretty;
  }

  .reel-card:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    /* Run to the screen edge so the next clip peeks in. */
    .reels {
      margin-inline: calc(var(--page-margin, 1rem) * -1);
      padding-inline: var(--page-margin, 1rem);
      scroll-padding-inline-start: var(--page-margin, 1rem);
    }
  }

  @media screen and (min-width: 750px) {
    .reels__item {
      flex-basis: calc((100% - var(--reels-gap) * var(--reels-columns)) / (var(--reels-columns) + 0.25));
    }
  }

  /*
   * Viewer
   * A vertical scroll-snap feed inside a native <dialog>: swipe on touch, arrows and
   * arrow keys on desktop, Esc to close — all for free.
   */
  :root.reels-viewer-open {
    overflow: hidden;
  }

  .reels-viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #000;
    color: #fff;
    overflow: hidden;
  }

  .reels-viewer::backdrop {
    background: #000;
  }

  .reels-viewer__track {
    height: 100%;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .reels-viewer__track:focus-visible {
    outline: none;
  }

  .reels-viewer__track::-webkit-scrollbar {
    display: none;
  }

  .reel-slide {
    position: relative;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .reel-slide__stage {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
  }

  .reel-slide__video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* An invisible hit area so a tap anywhere on the video pauses it. */
  .reel-slide__toggle {
    position: absolute;
    inset: 0;
    border: 0;
    background: none;
    cursor: pointer;
    appearance: none;
  }

  .reel-slide__paused {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .reel-slide--paused .reel-slide__paused {
    opacity: 1;
  }

  .reel-slide__paused svg {
    width: 1.75rem;
    height: 1.75rem;
    margin-inline-start: 3px;
    fill: #fff;
  }

  /* Tagged products: a swipeable strip over the video on phones. */
  .reel-slide__products {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 2;
    padding-block: 3rem 1.25rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent);
    pointer-events: none;
  }

  .reel-slide__caption {
    margin: 0 0 0.75rem;
    padding-inline: 1rem;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .reel-products {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    pointer-events: auto;
  }

  .reel-products::-webkit-scrollbar {
    display: none;
  }

  .reel-products__item {
    flex: 0 0 min(84%, 20rem);
    scroll-snap-align: start;
  }

  .reel-product {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem;
    border-radius: 14px;
    background: #fff;
    color: #1a1a1a;
    text-decoration: none;
  }

  .reel-product__media {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9px;
    overflow: hidden;
    background: #f3f3f3;
  }

  .reel-product__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reel-product__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-width: 0;
  }

  .reel-product__title {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reel-product__prices {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    font-size: 0.8125rem;
  }

  .reel-product__price {
    font-weight: 600;
  }

  .reel-product__price--sale {
    color: #a11c1c;
  }

  .reel-product__compare {
    color: rgb(0 0 0 / 0.45);
    font-size: 0.75rem;
  }

  .reel-product__cta {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.4;
  }

  .reel-product__cta svg {
    width: 1rem;
    height: 1rem;
    fill: currentcolor;
  }

  /* Viewer chrome */
  .reels-viewer__ui {
    pointer-events: none;
  }

  .reels-viewer__btn {
    position: absolute;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
  }

  .reels-viewer__btn svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentcolor;
  }

  .reels-viewer__close {
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
  }

  .reels-viewer__sound {
    inset-block-start: 1rem;
    inset-inline-end: 4rem;
  }

  .reels-viewer__icon-sound,
  .reels--sound-on .reels-viewer__icon-muted {
    display: none;
  }

  .reels--sound-on .reels-viewer__icon-sound {
    display: block;
  }

  /* Up/down arrows are for pointers; touch users just swipe. */
  .reels-viewer__nav {
    display: none;
  }

  .reels-viewer__count {
    position: absolute;
    inset-block-end: 0.5rem;
    inset-inline: 0;
    z-index: 3;
    margin: 0;
    text-align: center;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: rgb(255 255 255 / 0.5);
  }

  @media screen and (min-width: 750px) {
    .reels-viewer__nav {
      display: block;
    }

    .reels-viewer__nav [data-reels-step='-1'] {
      inset-block-start: calc(50% - 3rem);
      inset-inline-end: 1.5rem;
    }

    .reels-viewer__nav [data-reels-step='1'] {
      inset-block-start: calc(50% + 0.5rem);
      inset-inline-end: 1.5rem;
    }

    /* On a wide screen the clip stays 9:16 and the products sit beside it. */
    .reel-slide {
      display: grid;
      grid-template-columns: minmax(0, auto) minmax(18rem, 24rem);
      align-items: center;
      justify-content: center;
      gap: 2.5rem;
      padding: 2.5rem 6rem;
      box-sizing: border-box;
    }

    .reel-slide__stage {
      width: auto;
      height: 100%;
      aspect-ratio: 9 / 16;
      max-height: 100%;
      justify-self: end;
      border-radius: 12px;
      overflow: hidden;
    }

    .reel-slide__video {
      object-fit: cover;
    }

    .reel-slide__products {
      position: static;
      padding: 0;
      background: none;
      pointer-events: auto;
    }

    .reel-slide__caption {
      padding-inline: 0;
      margin-block-end: 1rem;
      font-size: 1rem;
    }

    .reel-products {
      flex-direction: column;
      padding: 0;
      overflow: visible;
      max-height: 60vh;
      overflow-y: auto;
    }

    .reel-products__item {
      flex-basis: auto;
    }

    /* Without a video to sit over, the cards need their own edge. */
    .reel-product {
      background: rgb(255 255 255 / 0.06);
      color: #fff;
      border: 1px solid rgb(255 255 255 / 0.12);
      transition: background 0.2s ease;
    }

    @media (hover: hover) {
      .reel-product:hover {
        background: rgb(255 255 255 / 0.12);
      }
    }

    .reel-product__compare {
      color: rgb(255 255 255 / 0.45);
    }

    .reel-product__price--sale {
      color: #ff9f9f;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reels-viewer__track,
    .reels {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

