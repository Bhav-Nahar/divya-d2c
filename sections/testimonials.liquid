{%- liquid
  assign s = section.settings
-%}

<div
  class="
    testimonials-section section section--{{ s.section_width }} spacing-style
    {% if s.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.background_color != blank -%}
    {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
  {%- endif -%}

  {%- if s.heading != blank or s.subheading != blank -%}
    <div class="testimonials__header testimonials__header--{{ s.heading_alignment }}">
      {%- if s.heading != blank -%}
        <h2 class="testimonials__heading {{ s.heading_level }}">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="testimonials__subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <scroll-row{% if s.autoplay and s.desktop_layout == 'scroll' %} autoplay="{{ s.autoplay_speed }}"{% endif %}>
  <ul
    class="testimonials testimonials--{{ s.card_style }} testimonials--desktop-{{ s.desktop_layout }}"
    data-scroll-track
    style="--tm-columns: {{ s.columns }}; --tm-gap: {{ s.gap }}px; --tm-radius: {{ s.corner_radius }}px;"
  >
    {%- for block in section.blocks -%}
      <li class="testimonials__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <span class="testimonials__media" style="--tm-ratio: {{ s.ratio }};">
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 80vw, 25vw', widths: '300,450,600,800', alt: block.settings.author
            }}
          </span>
        {%- endif -%}

        {%- if block.settings.title != blank -%}
          <p class="testimonials__title">{{ block.settings.title }}</p>
        {%- endif -%}

        {%- if s.show_stars and block.settings.rating > 0 -%}
          <span class="testimonials__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              <span class="testimonials__star{% if i > block.settings.rating %} testimonials__star--empty{% endif %}" aria-hidden="true">★</span>
            {%- endfor -%}
          </span>
        {%- endif -%}

        {%- if block.settings.quote != blank -%}
          <blockquote class="testimonials__quote">{{ block.settings.quote }}</blockquote>
        {%- endif -%}

        {%- if block.settings.author != blank or block.settings.detail != blank -%}
          <p class="testimonials__footer">
            <span class="testimonials__name">{{ block.settings.author }}</span>
            {%- if block.settings.detail != blank -%}
              <span class="testimonials__date">{{ block.settings.detail }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}
      </li>
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      {%- comment -%} ponytail: placeholders so the section is visible before reviews are added {%- endcomment -%}
      {%- for i in (1..3) -%}
        <li class="testimonials__item">
          <blockquote class="testimonials__quote">Add a review to see it here.</blockquote>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
  {%- if s.desktop_layout == 'scroll' -%}
    {% render 'scroll-row-arrows', label: 'reviews' %}
  {%- endif -%}
  </scroll-row>
</div>

{% stylesheet %}
  .testimonials__header {
    margin-block-end: 2rem;
  }

  .testimonials__header--center {
    text-align: center;
  }

  .testimonials__heading {
    margin: 0;
    line-height: 1.2;
  }

  .testimonials__subheading {
    margin: 0.5rem 0 0 0;
    opacity: 0.75;
  }

  .testimonials {
    display: flex;
    gap: var(--tm-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    /* ponytail: scroll on mobile, grid on desktop — no carousel component needed. */
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .testimonials::-webkit-scrollbar {
    display: none;
  }

  .testimonials__item {
    flex: 0 0 82%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /* Boxed: soft tinted card with a hairline edge, no heavy border. */
  .testimonials--boxed .testimonials__item {
    padding: 1rem 1.125rem 0.875rem;
    border: 1px solid rgb(from currentcolor r g b / 0.06);
    border-radius: var(--tm-radius);
    background: rgb(from currentcolor r g b / 0.03);
  }

  .testimonials__media {
    display: block;
    aspect-ratio: var(--tm-ratio);
    overflow: hidden;
    border-radius: var(--tm-radius);
    background: var(--color-background-secondary, #f3f3f3);
    margin-block-end: 0.375rem;
  }

  .testimonials__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .testimonials__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .testimonials__stars {
    display: flex;
    gap: 1px;
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0;
  }

  .testimonials__star--empty {
    opacity: 0.2;
  }

  .testimonials__quote {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgb(from currentcolor r g b / 0.8);
    /* Three lines keeps every card the same height. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Name left, date right, pinned to the bottom so uneven quotes still line up. */
  .testimonials__footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: auto 0 0;
    padding-block-start: 0.5rem;
    font-size: 0.75rem;
  }

  .testimonials__name {
    font-weight: 600;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .testimonials__date {
    flex: none;
    color: rgb(from currentcolor r g b / 0.55);
  }

  @media screen and (max-width: 749px) {
    .testimonials__header {
      margin-block-end: 1rem;
    }
  }

  @media screen and (min-width: 750px) {
    /* Scrolling row on desktop too: columns + a peek of the next card. */
    .testimonials--desktop-scroll .testimonials__item {
      flex-basis: calc((100% - var(--tm-gap) * var(--tm-columns)) / (var(--tm-columns) + 0.25));
    }

    .testimonials--desktop-grid {
      display: grid;
      grid-template-columns: repeat(var(--tm-columns), 1fr);
      overflow-x: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading size",
      "info": "Uses the theme's heading scale, set in Theme settings > Typography.",
      "options": [
        {
          "value": "h1",
          "label": "Extra large"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h4",
          "label": "Small"
        },
        {
          "value": "h5",
          "label": "Extra small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "boxed",
          "label": "Boxed"
        }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "scroll",
          "label": "Scrolling row"
        }
      ],
      "default": "grid",
      "info": "Mobile always scrolls, with the next review peeking in."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-scroll reviews",
      "default": false,
      "info": "Glides slowly and loops. Pauses on hover or touch. Needs Desktop layout: Scrolling row.",
      "visible_if": "{{ section.settings.desktop_layout == 'scroll' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-scroll speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30,
      "info": "Pixels per second.",
      "visible_if": "{{ section.settings.desktop_layout == 'scroll' and section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between reviews",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1"
        },
        {
          "value": "4 / 5",
          "label": "4:5"
        },
        {
          "value": "4 / 3",
          "label": "4:3"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star ratings",
      "default": true
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Short headline shown first, e.g. So chic!"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Date",
          "info": "Shown beside the name, e.g. 2 weeks ago or Aug 2026."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
