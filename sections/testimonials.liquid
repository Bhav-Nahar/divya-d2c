{%- liquid
  assign s = section.settings
-%}

<div
  class="
    testimonials-section section section--{{ s.section_width }} spacing-style
    {% if s.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.background_color != blank -%}
    {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
  {%- endif -%}

  {%- if s.heading != blank or s.subheading != blank -%}
    <div class="testimonials__header testimonials__header--{{ s.heading_alignment }}">
      {%- if s.heading != blank -%}
        <h2 class="testimonials__heading {{ s.heading_level }}">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="testimonials__subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul
    class="testimonials testimonials--{{ s.card_style }}"
    style="--tm-columns: {{ s.columns }}; --tm-gap: {{ s.gap }}px; --tm-radius: {{ s.corner_radius }}px;"
  >
    {%- for block in section.blocks -%}
      <li class="testimonials__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <span class="testimonials__media" style="--tm-ratio: {{ s.ratio }};">
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 80vw, 25vw', widths: '300,450,600,800', alt: block.settings.author
            }}
          </span>
        {%- endif -%}

        {%- if s.show_stars and block.settings.rating > 0 -%}
          <span class="testimonials__stars" aria-label="{{ block.settings.rating }} out of 5">
            {%- for i in (1..5) -%}
              <span class="testimonials__star{% if i > block.settings.rating %} testimonials__star--empty{% endif %}">★</span>
            {%- endfor -%}
          </span>
        {%- endif -%}

        {%- if block.settings.quote != blank -%}
          <blockquote class="testimonials__quote">{{ block.settings.quote }}</blockquote>
        {%- endif -%}

        {%- if block.settings.author != blank or block.settings.detail != blank -%}
          <p class="testimonials__author">
            {%- if block.settings.author != blank -%}
              <span class="testimonials__name">{{ block.settings.author }}</span>
            {%- endif -%}
            {%- if block.settings.detail != blank -%}
              <span class="testimonials__detail">{{ block.settings.detail }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}
      </li>
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      {%- comment -%} ponytail: placeholders so the section is visible before reviews are added {%- endcomment -%}
      {%- for i in (1..3) -%}
        <li class="testimonials__item">
          <blockquote class="testimonials__quote">Add a review to see it here.</blockquote>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .testimonials__header {
    margin-block-end: 2rem;
  }

  .testimonials__header--center {
    text-align: center;
  }

  .testimonials__heading {
    margin: 0;
    line-height: 1.2;
  }

  .testimonials__subheading {
    margin: 0.5rem 0 0 0;
    opacity: 0.75;
  }

  .testimonials {
    display: flex;
    gap: var(--tm-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    /* ponytail: scroll on mobile, grid on desktop — no carousel component needed. */
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .testimonials::-webkit-scrollbar {
    display: none;
  }

  .testimonials__item {
    flex: 0 0 80%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .testimonials--boxed .testimonials__item {
    padding: 1.5rem;
    border: 1px solid rgb(from currentcolor r g b / 0.12);
    border-radius: var(--tm-radius);
  }

  .testimonials__media {
    display: block;
    aspect-ratio: var(--tm-ratio);
    overflow: hidden;
    border-radius: var(--tm-radius);
    background: var(--color-background-secondary, #f3f3f3);
  }

  .testimonials__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.125rem;
    font-size: 0.875rem;
    line-height: 1;
  }

  .testimonials__star--empty {
    opacity: 0.25;
  }

  .testimonials__quote {
    margin: 0;
    line-height: 1.6;
  }

  .testimonials__author {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: 0.8125rem;
  }

  .testimonials__detail {
    opacity: 0.65;
  }

  @media screen and (min-width: 750px) {
    .testimonials {
      display: grid;
      grid-template-columns: repeat(var(--tm-columns), 1fr);
      overflow-x: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading size",
      "info": "Uses the theme's heading scale, set in Theme settings > Typography.",
      "options": [
        { "value": "h1", "label": "Extra large" },
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" },
        { "value": "h4", "label": "Small" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "boxed", "label": "Boxed" }
      ],
      "default": "plain"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between reviews",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "1:1" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "4 / 3", "label": "4:3" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star ratings",
      "default": true
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "Product bought, location, or Verified buyer."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
