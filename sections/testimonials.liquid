{%- liquid
  assign s = section.settings
-%}

<div
  class="
    testimonials-section section section--{{ s.section_width }} spacing-style
    {% if s.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.background_color != blank -%}
    {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
  {%- endif -%}

  {%- if s.heading != blank or s.subheading != blank -%}
    <div class="testimonials__header testimonials__header--{{ s.heading_alignment }}">
      {%- if s.heading != blank -%}
        <h2 class="testimonials__heading {{ s.heading_level }}">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="testimonials__subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <scroll-row{% if s.autoplay and s.desktop_layout == 'scroll' %} autoplay="{{ s.autoplay_speed }}"{% endif %}>
  <ul
    class="testimonials testimonials--{{ s.card_style }} testimonials--desktop-{{ s.desktop_layout }} testimonials--text-{{ s.card_text_size | default: 'regular' }}"
    data-scroll-track
    style="--tm-columns: {{ s.columns }}; --tm-gap: {{ s.gap }}px; --tm-radius: {{ s.corner_radius }}px;"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        # Initials for the monogram, e.g. "Ananya R." -> "AR"
        assign name_parts = block.settings.author | strip | split: ' '
        assign initials = ''
        for part in name_parts limit: 2
          assign first_letter = part | slice: 0, 1 | upcase
          assign initials = initials | append: first_letter
        endfor
      -%}
      <li class="testimonials__item" {{ block.shopify_attributes }}>
        <article class="review-card">
          {%- if block.settings.image != blank -%}
            <span class="review-card__media" style="--tm-ratio: {{ s.ratio }};">
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 80vw, 25vw', widths: '300,450,600,800', alt: block.settings.author
              }}
            </span>
          {%- endif -%}

          <div class="review-card__body">
            {%- if s.show_stars and block.settings.rating > 0 -%}
              <span class="review-card__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <span class="review-card__star{% if i > block.settings.rating %} review-card__star--empty{% endif %}" aria-hidden="true">★</span>
                {%- endfor -%}
              </span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <p class="review-card__title">{{ block.settings.title }}</p>
            {%- endif -%}

            {%- if block.settings.quote != blank -%}
              <blockquote class="review-card__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}
          </div>

          {%- if block.settings.author != blank or block.settings.detail != blank -%}
            <footer class="review-card__author">
              {%- if initials != blank -%}
                <span class="review-card__avatar" aria-hidden="true">{{ initials }}</span>
              {%- endif -%}
              <span class="review-card__identity">
                {%- if block.settings.author != blank -%}
                  <span class="review-card__name">{{ block.settings.author }}</span>
                {%- endif -%}
                {%- if block.settings.detail != blank -%}
                  <span class="review-card__detail">{{ block.settings.detail }}</span>
                {%- endif -%}
              </span>
            </footer>
          {%- endif -%}
        </article>
      </li>
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      {%- comment -%} ponytail: placeholders so the section is visible before reviews are added {%- endcomment -%}
      {%- for i in (1..3) -%}
        <li class="testimonials__item">
          <article class="review-card">
            <div class="review-card__body">
              <blockquote class="review-card__quote">Add a review to see it here.</blockquote>
            </div>
          </article>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
  {%- if s.desktop_layout == 'scroll' -%}
    {% render 'scroll-row-arrows', label: 'reviews' %}
  {%- endif -%}
  </scroll-row>
</div>

{% stylesheet %}
  .testimonials-section {
    --review-surface: light-dark(rgb(255 255 255 / 0.72), rgb(255 255 255 / 0.04));
    --review-edge: rgb(from currentcolor r g b / 0.1);
    --review-muted: rgb(from currentcolor r g b / 0.58);
  }

  .testimonials__header {
    margin-block-end: 2.5rem;
  }

  .testimonials__header--center {
    text-align: center;
  }

  .testimonials__heading {
    margin: 0;
    line-height: 1.15;
    text-wrap: balance;
  }

  .testimonials__subheading {
    margin: 0.75rem auto 0;
    max-width: 46ch;
    color: var(--review-muted);
  }

  .testimonials {
    display: flex;
    gap: var(--tm-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    /* Scroll on mobile, grid on desktop — no carousel component needed. */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .testimonials::-webkit-scrollbar {
    display: none;
  }

  .testimonials__item {
    flex: 0 0 82%;
    scroll-snap-align: start;
    display: flex;
  }

  /*
   * Review card
   * A quiet surface that lets the quote lead: rating first, quote at reading
   * size, attribution anchored to the bottom so uneven quotes still line up.
   */
  .review-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    padding: 1.75rem 1.5rem 1.5rem;
    border: 1px solid var(--review-edge);
    border-radius: max(var(--tm-radius), 12px);
    background: var(--review-surface);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease;
  }

  /* A soft quotation mark, set behind the content as texture rather than decoration. */
  .review-card::before {
    content: '\201C';
    position: absolute;
    inset-block-start: 0.15em;
    inset-inline-end: 0.4em;
    font-size: 4.5rem;
    line-height: 1;
    font-family: var(--font-heading--family, serif);
    color: currentcolor;
    opacity: 0.08;
    pointer-events: none;
  }

  @media (hover: hover) {
    .review-card:hover {
      transform: translateY(-3px);
      border-color: rgb(from currentcolor r g b / 0.18);
      box-shadow: 0 14px 32px -18px rgb(from currentcolor r g b / 0.4);
    }
  }

  /* The plain style drops the surface but keeps the rhythm of the boxed one. */
  .testimonials--plain .review-card {
    padding: 0;
    border: 0;
    background: none;
    border-radius: 0;
  }

  .testimonials--plain .review-card::before {
    display: none;
  }

  @media (hover: hover) {
    .testimonials--plain .review-card:hover {
      transform: none;
      box-shadow: none;
    }
  }

  .review-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .review-card__media {
    display: block;
    aspect-ratio: var(--tm-ratio);
    overflow: hidden;
    border-radius: max(calc(var(--tm-radius) - 2px), 8px);
    background: var(--color-background-secondary, #f3f3f3);
  }

  .review-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
    font-size: 0.8125rem;
    line-height: 1;
  }

  .review-card__star--empty {
    opacity: 0.22;
  }

  .review-card__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .review-card__quote {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
    /* Four lines keeps every card the same height without clipping short quotes. */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .review-card__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: auto;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--review-edge);
  }

  .testimonials--plain .review-card__author {
    border-block-start: 0;
    padding-block-start: 0.5rem;
  }

  /* Monogram stands in for a customer photo, so every card reads the same. */
  .review-card__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(from currentcolor r g b / 0.08);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .review-card__identity {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .review-card__name {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .review-card__detail {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--review-muted);
  }

  /*
   * Compact: the pre-existing smaller scale, for the review strip that sits above
   * a product grid where it should stay secondary to the products.
   */
  .testimonials--text-compact .review-card {
    padding: 1.125rem 1.25rem 1rem;
    gap: 0.75rem;
  }

  .testimonials--text-compact .review-card::before {
    font-size: 3rem;
  }

  .testimonials--text-compact .review-card__quote {
    font-size: 0.8125rem;
    line-height: 1.55;
    -webkit-line-clamp: 3;
  }

  .testimonials--text-compact .review-card__title {
    font-size: 0.875rem;
  }

  .testimonials--text-compact .review-card__stars {
    font-size: 0.6875rem;
  }

  .testimonials--text-compact .review-card__author {
    padding-block-start: 0.75rem;
    gap: 0.625rem;
  }

  .testimonials--text-compact .review-card__avatar {
    width: 1.875rem;
    height: 1.875rem;
    font-size: 0.6875rem;
  }

  .testimonials--text-compact .review-card__name {
    font-size: 0.8125rem;
  }

  .testimonials--text-compact .review-card__detail {
    font-size: 0.6875rem;
  }

  @media screen and (max-width: 749px) {
    .testimonials__header {
      margin-block-end: 1.5rem;
    }

    /* Let the row run to the screen edge so the next card peeks in. */
    .testimonials {
      margin-inline: calc(var(--page-margin, 1rem) * -1);
      padding-inline: var(--page-margin, 1rem);
      scroll-padding-inline-start: var(--page-margin, 1rem);
    }

    .testimonials__item {
      flex-basis: min(78%, 20rem);
    }

    .review-card {
      padding: 1.5rem 1.25rem 1.25rem;
    }
  }

  @media screen and (min-width: 750px) {
    /* Scrolling row on desktop too: columns + a peek of the next card. */
    .testimonials--desktop-scroll .testimonials__item {
      flex-basis: calc((100% - var(--tm-gap) * var(--tm-columns)) / (var(--tm-columns) + 0.25));
    }

    .testimonials--desktop-grid {
      display: grid;
      grid-template-columns: repeat(var(--tm-columns), 1fr);
      overflow-x: visible;
    }

    .testimonials:not(.testimonials--text-compact) .review-card__quote {
      font-size: 1.0625rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading size",
      "info": "Uses the theme's heading scale, set in Theme settings > Typography.",
      "options": [
        {
          "value": "h1",
          "label": "Extra large"
        },
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h4",
          "label": "Small"
        },
        {
          "value": "h5",
          "label": "Extra small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "card_text_size",
      "label": "Card text size",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "boxed",
          "label": "Boxed"
        }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "scroll",
          "label": "Scrolling row"
        }
      ],
      "default": "grid",
      "info": "Mobile always scrolls, with the next review peeking in."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-scroll reviews",
      "default": false,
      "info": "Glides slowly and loops. Pauses on hover or touch. Needs Desktop layout: Scrolling row.",
      "visible_if": "{{ section.settings.desktop_layout == 'scroll' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-scroll speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30,
      "info": "Pixels per second.",
      "visible_if": "{{ section.settings.desktop_layout == 'scroll' and section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between reviews",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1"
        },
        {
          "value": "4 / 5",
          "label": "4:5"
        },
        {
          "value": "4 / 3",
          "label": "4:3"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star ratings",
      "default": true
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Short headline shown first, e.g. So chic!"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Date",
          "info": "Shown beside the name, e.g. 2 weeks ago or Aug 2026."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
