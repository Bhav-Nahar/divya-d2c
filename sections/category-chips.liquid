{%- liquid
  assign s = section.settings
  assign is_card = false
  if s.style == 'card'
    assign is_card = true
  endif
-%}

<div
  class="
    category-chips-section category-chips-section--show-{{ s.visibility }}
    section section--{{ s.section_width }} spacing-style
  "
  style="{% render 'spacing-style', settings: s %}"
>
  {%- if s.heading != blank or s.subheading != blank -%}
    <div class="category-chips__header category-chips__header--{{ s.heading_alignment }}">
      {%- if s.heading != blank -%}
        <h2 class="category-chips__heading {{ s.heading_level }}">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="category-chips__subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul
    class="
      category-chips category-chips--{{ s.style }} category-chips--{{ s.shape }}
      category-chips--label-{{ s.label_alignment }}
    "
    style="
      --chip-size: {{ s.size }}px;
      --chip-columns: {{ s.desktop_columns }};
      --chip-columns-mobile: {{ s.mobile_columns }};
      --chip-ratio: {{ s.ratio }};
      --chip-radius: {{ s.corner_radius }}px;
    "
  >
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image
          assign label = block.settings.label
          if image == blank and block.settings.collection != blank
            assign image = block.settings.collection.featured_image
          endif
          if label == blank and block.settings.collection != blank
            assign label = block.settings.collection.title
          endif
          assign url = block.settings.link | default: block.settings.collection.url
        -%}
        <li class="category-chips__item" {{ block.shopify_attributes }}>
          <a class="category-chips__link" href="{{ url | default: '#' }}">
            <span class="category-chips__media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 1000
                  | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 50vw, 25vw', widths: '200,300,400,600,800,1000', alt: label
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if is_card -%}
                <span class="category-chips__scrim"></span>
                <span class="category-chips__overlay">
                  <span class="category-chips__label">{{ label }}</span>
                  {%- if s.show_arrow -%}
                    <span class="category-chips__arrow" aria-hidden="true">
                      <svg viewBox="0 0 20 20" width="20" height="20">
                        {%- render 'icon', icon: 'arrow' -%}
                      </svg>
                    </span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </span>
            {%- unless is_card -%}
              <span class="category-chips__label">{{ label }}</span>
            {%- endunless -%}
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} ponytail: placeholders so the section is visible before blocks are added {%- endcomment -%}
      {%- for i in (1..4) -%}
        <li class="category-chips__item">
          <span class="category-chips__link">
            <span class="category-chips__media">
              {{ 'collection-1' | placeholder_svg_tag }}
              {%- if is_card -%}
                <span class="category-chips__scrim"></span>
                <span class="category-chips__overlay">
                  <span class="category-chips__label">Category</span>
                </span>
              {%- endif -%}
            </span>
            {%- unless is_card -%}<span class="category-chips__label">Category</span>{%- endunless -%}
          </span>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .category-chips__header {
    margin-block-end: 1.5rem;
  }

  .category-chips__header--center {
    text-align: center;
  }

  .category-chips__heading {
    margin: 0;
  }

  .category-chips__subheading {
    margin: 0.5rem 0 0 0;
    opacity: 0.75;
  }

  .category-chips {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-chips__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .category-chips__media {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--color-background-secondary, #f3f3f3);
  }

  .category-chips__media :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---- Tile style: round or square thumb with the label underneath ---- */

  .category-chips--tile {
    display: flex;
    gap: var(--gap-md, 1rem);
    /* ponytail: overflow scroll instead of a carousel component — native momentum
       scrolling covers it. Swap for scroll-container if arrows are ever needed. */
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .category-chips--tile::-webkit-scrollbar {
    display: none;
  }

  .category-chips--tile .category-chips__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: var(--chip-size);
  }

  .category-chips--tile .category-chips__media {
    width: var(--chip-size);
    aspect-ratio: 1;
  }

  .category-chips--tile.category-chips--circle .category-chips__media {
    border-radius: 50%;
  }

  .category-chips--tile.category-chips--rounded .category-chips__media {
    border-radius: var(--style-border-radius-buttons, 8px);
  }

  .category-chips--tile .category-chips__label {
    display: block;
    margin-block-start: 0.625rem;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  /* ---- Card style: full-bleed image with the label and arrow sitting on it ---- */

  .category-chips--card {
    display: grid;
    grid-template-columns: repeat(var(--chip-columns-mobile), 1fr);
    gap: var(--gap-md, 1rem);
  }

  .category-chips--card .category-chips__media {
    aspect-ratio: var(--chip-ratio);
    border-radius: var(--chip-radius);
  }

  .category-chips__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0) 45%);
    pointer-events: none;
  }

  .category-chips__overlay {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    color: #fff;
  }

  .category-chips--card .category-chips__label {
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  /* Centred labels read as a link rather than a caption, so underline them and
     drop the arrow's claim on the right-hand side. */
  .category-chips--label-center .category-chips__overlay {
    justify-content: center;
  }

  .category-chips--label-center .category-chips__label {
    text-decoration: underline;
    text-underline-offset: 0.4em;
    letter-spacing: 0.08em;
  }

  .category-chips__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 50%;
  }

  .category-chips__arrow svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: currentcolor;
  }

  @media screen and (max-width: 749px) {
    .shopify-section:has(> .category-chips-section--show-desktop) {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .shopify-section:has(> .category-chips-section--show-mobile) {
      display: none;
    }

    /* Desktop lays the same blocks out as an even grid — no scrolling, and tiles
       size to the container rather than the fixed mobile chip size. */
    .category-chips--tile {
      display: grid;
      grid-template-columns: repeat(var(--chip-columns), 1fr);
      gap: var(--gap-lg, 2rem);
      overflow-x: visible;
    }

    .category-chips--tile .category-chips__item {
      width: auto;
    }

    .category-chips--tile .category-chips__media {
      width: 100%;
    }

    .category-chips--tile .category-chips__label {
      margin-block-start: 0.875rem;
      font-size: 0.8125rem;
      letter-spacing: 0.1em;
    }

    .category-chips--card {
      grid-template-columns: repeat(var(--chip-columns), 1fr);
      gap: var(--gap-lg, 1.5rem);
    }

    .category-chips__overlay {
      padding: 1.25rem;
    }

    .category-chips--card .category-chips__label {
      font-size: 1.0625rem;
    }

    .category-chips__link:hover .category-chips__media :is(img, svg) {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-chips__media :is(img, svg) {
      transition: none;
    }

    .category-chips__link:hover .category-chips__media :is(img, svg) {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "tile", "label": "Thumbnail with label below" },
        { "value": "card", "label": "Image card with label on top" }
      ],
      "default": "tile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty for a bare row."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading size",
      "info": "Uses the theme's heading scale, set in Theme settings > Typography.",
      "options": [
        { "value": "h1", "label": "Extra large" },
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" },
        { "value": "h4", "label": "Small" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Show on",
      "options": [
        { "value": "mobile", "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "both", "label": "Mobile and desktop" }
      ],
      "default": "both"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "info": "Card style only. Thumbnails always scroll on mobile."
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Card ratio",
      "options": [
        { "value": "1 / 1", "label": "1:1 square" },
        { "value": "4 / 5", "label": "4:5 portrait" },
        { "value": "3 / 4", "label": "3:4 tall" },
        { "value": "4 / 3", "label": "4:3 landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "label_alignment",
      "label": "Card label position",
      "options": [
        { "value": "left", "label": "Bottom left" },
        { "value": "center", "label": "Bottom centre" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow on cards",
      "default": true
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Thumbnail shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "rounded", "label": "Rounded square" },
        { "value": "square", "label": "Square" }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Thumbnail size",
      "min": 64,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Supplies the image, label, and link unless you override them below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [{ "type": "chip" }, { "type": "chip" }, { "type": "chip" }, { "type": "chip" }]
    }
  ]
}
{% endschema %}
