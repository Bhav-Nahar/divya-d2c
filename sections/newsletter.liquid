{%- liquid
  assign s = section.settings
  assign form_id = 'newsletter-' | append: section.id
-%}

<div
  class="newsletter section section--{{ s.section_width }} spacing-style"
  style="{% render 'spacing-style', settings: s %}"
>
  <div class="newsletter__panel">
    {%- if s.heading != blank -%}
      <h2 class="newsletter__heading">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="newsletter__text">{{ s.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__message newsletter__message--success" role="status">{{ s.success_text }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label class="visually-hidden" for="{{ form_id }}-email">Email address</label>
          <input
            id="{{ form_id }}-email"
            class="newsletter__input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="{{ s.placeholder }}"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
          >
          <button class="newsletter__button" type="submit">{{ s.button_label }}</button>
        </div>
        {%- if form.errors -%}
          <p class="newsletter__message newsletter__message--error" id="{{ form_id }}-error" role="alert">
            {{- form.errors | default_errors -}}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    {%- if s.note != blank -%}
      <p class="newsletter__note">{{ s.note }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .newsletter__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 38rem;
    margin-inline: auto;
    padding-block: 1rem;
    text-align: center;
  }

  .newsletter__heading {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    line-height: 1.2;
  }

  .newsletter__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.75;
    text-wrap: balance;
  }

  .newsletter__form {
    width: 100%;
    margin-block-start: 0.75rem;
  }

  .newsletter__field {
    display: flex;
    width: 100%;
    border: 1px solid rgb(from currentcolor r g b / 0.35);
    background: transparent;
  }

  .newsletter__field:focus-within {
    border-color: currentcolor;
  }

  .newsletter__input {
    flex: 1;
    min-width: 0;
    padding: 0.875rem 1rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
  }

  .newsletter__input::placeholder {
    color: inherit;
    opacity: 0.5;
  }

  .newsletter__button {
    flex: none;
    padding: 0 1.5rem;
    border: 0;
    background: currentcolor;
    cursor: pointer;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Text stays readable on whatever the button colour resolves to. */
  .newsletter__button {
    color: var(--color-background, #fff);
    background: var(--color-foreground, #000);
  }

  .newsletter__button:hover {
    opacity: 0.85;
  }

  .newsletter__message {
    margin: 0;
    font-size: 0.875rem;
  }

  .newsletter__message--error {
    margin-block-start: 0.5rem;
    color: #b42318;
  }

  .newsletter__note {
    margin: 0;
    font-size: 0.75rem;
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .newsletter__panel {
      gap: 0.625rem;
      padding: 2rem 1.25rem;
      border: 1px solid rgb(from currentcolor r g b / 0.15);
      background: rgb(from currentcolor r g b / 0.04);
    }

    .newsletter__text {
      font-size: 0.875rem;
      max-width: 28ch;
    }

    .newsletter__form {
      margin-block-start: 0.5rem;
    }

    /* Two separate controls read cleaner than one boxed field on a narrow screen. */
    .newsletter__field {
      flex-direction: column;
      gap: 0.625rem;
      border: 0;
    }

    .newsletter__input {
      width: 100%;
      min-height: 3rem;
      padding: 0 1rem;
      border: 1px solid rgb(from currentcolor r g b / 0.35);
      background: var(--color-background, #fff);
      /* 16px stops iOS from zooming the page when the field is focused. */
      font-size: 1rem;
    }

    .newsletter__input:focus {
      border-color: currentcolor;
    }

    .newsletter__button {
      width: 100%;
      min-height: 3rem;
      padding: 0 1rem;
    }

    .newsletter__note {
      margin-block-start: 0.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the loop"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Leave your email for new arrivals, restocks and offers. No fixed schedule, no spam."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Keep me posted"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thank you for subscribing."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "Unsubscribe any time."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
