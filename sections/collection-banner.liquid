{%- liquid
  assign s = section.settings

  # The collection's own image wins; the setting is a fallback for collections without one.
  assign banner_image = collection.image | default: s.image
  assign mobile_image = s.image_mobile | default: banner_image
  assign banner_alt = banner_image.alt | default: collection.title | strip_html
  assign banner_text = collection.description | strip_html | truncatewords: 24

  assign points = ''
  if s.point_1 != blank
    assign points = points | append: s.point_1 | append: '||'
  endif
  if s.point_2 != blank
    assign points = points | append: s.point_2 | append: '||'
  endif
  if s.point_3 != blank
    assign points = points | append: s.point_3 | append: '||'
  endif
  assign points_list = points | split: '||' | compact
-%}

{%- if collection != blank -%}
  <div
    class="collection-banner section--full-width{% if banner_image == blank %} collection-banner--no-image{% endif %}"
    style="
      --cb-bg: {{ s.background_color }};
      --cb-height: {{ s.height_desktop }}rem;
      --cb-ratio-mobile: {{ s.ratio_mobile }};
    "
  >
    {%- if banner_image != blank -%}
      <div class="collection-banner__media">
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1080 }} 1080w,
              {{ mobile_image | image_url: width: 1500 }} 1500w
            "
            sizes="100vw"
          >
          {{
            banner_image
            | image_url: width: 2000
            | image_tag:
              widths: '750, 1100, 1500, 2000',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: banner_alt
          }}
        </picture>
      </div>
    {%- endif -%}

    <div class="collection-banner__text">
      <div class="collection-banner__heading-row">
        <h1 class="collection-banner__title">{{ collection.title }}</h1>
        {%- if s.show_count -%}
          <span class="collection-banner__count">
            {{- collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif -%}
          </span>
        {%- endif -%}
      </div>

      {%- if s.show_description and banner_text != blank -%}
        <p class="collection-banner__description">{{ banner_text }}</p>
      {%- endif -%}

      {%- if points_list.size > 0 -%}
        <ul class="collection-banner__points">
          {%- for point in points_list -%}
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 1.25a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5Zm3.28 5.28-4 4a.75.75 0 0 1-1.06 0l-1.75-1.75a.75.75 0 0 1 1.06-1.06l1.22 1.22 3.47-3.47a.75.75 0 0 1 1.06 1.06Z" />
              </svg>
              {{ point }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /*
   * Compact split banner: image on top for phones, tinted text panel beside the
   * image on desktop. Short on purpose, so the products stay close to the fold.
   */
  .collection-banner {
    display: flex;
    flex-direction: column;
    background: var(--cb-bg);
  }

  .collection-banner__media {
    aspect-ratio: var(--cb-ratio-mobile);
    overflow: hidden;
  }

  .collection-banner__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .collection-banner__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-banner__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.125rem var(--page-margin, 1rem);
  }

  .collection-banner__heading-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .collection-banner__title {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
  }

  .collection-banner__count {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: rgb(from currentcolor r g b / 0.08);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .collection-banner__description {
    margin: 0;
    max-width: 52ch;
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0.75;
  }

  /* Trust points are for the wide layout only; phones stay clean. */
  .collection-banner__points {
    display: none;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
  }

  .collection-banner__points li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .collection-banner__points svg {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: currentcolor;
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    .collection-banner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: var(--cb-height);
    }

    .collection-banner--no-image {
      grid-template-columns: 1fr;
    }

    .collection-banner__media {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: auto;
      /* Page margin on the right so the image lines up with the product grid. */
      margin-inline-end: var(--page-margin, 3rem);
    }

    .collection-banner__text {
      grid-column: 1;
      grid-row: 1;
      padding: 1.5rem 2rem 1.5rem var(--page-margin, 3rem);
      gap: 0.75rem;
    }

    .collection-banner__points {
      display: flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the collection's own image (set it under Products, then Collections). The images below are only used when a collection has none."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Falls back to the main image."
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Mobile image ratio",
      "options": [
        { "value": "2 / 1", "label": "2:1 slim" },
        { "value": "16 / 7", "label": "16:7 slim" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "4 / 3", "label": "4:3" }
      ],
      "default": "16 / 7"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "rem",
      "default": 14
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Panel color",
      "default": "#f5ede3"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": false
    },
    {
      "type": "text",
      "id": "point_1",
      "label": "Point 1 (desktop)"
    },
    {
      "type": "text",
      "id": "point_2",
      "label": "Point 2 (desktop)"
    },
    {
      "type": "text",
      "id": "point_3",
      "label": "Point 3 (desktop)"
    }
  ]
}
{% endschema %}
